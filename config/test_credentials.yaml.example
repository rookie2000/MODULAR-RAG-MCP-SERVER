# Local API credentials template.
#
# Usage:
# 1. Copy this file to config/test_credentials.yaml.
# 2. Fill in the API keys you want to use.
# 3. Do not commit config/test_credentials.yaml. It is ignored by git.

# MiMo text LLM through the OpenAI-compatible provider in settings.yaml.
mimo:
  api_key: "<YOUR_MIMO_API_KEY>"
  model: "mimo-v2-pro"
  base_url: "https://token-plan-cn.xiaomimimo.com/v1"

# MiniMax embedding provider in settings.yaml.
minimax:
  api_key: "<YOUR_MINIMAX_API_KEY>"
  embedding_model: "embo-01"
  base_url: "https://api.minimax.chat/v1"

# Optional DeepSeek fallback for text LLM.
deepseek:
  api_key: "<YOUR_DEEPSEEK_API_KEY>"
  model: "deepseek-chat"
  base_url: "https://api.deepseek.com"

# Optional standard OpenAI.
openai:
  api_key: "<YOUR_OPENAI_API_KEY>"
  model: "gpt-4o"
  embedding_model: "text-embedding-3-small"
  base_url: "https://api.openai.com/v1"
